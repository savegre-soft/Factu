{
  "name": "factu",
  "version": "0.1.0",
  "description": "API de facturación electrónica para el Ministerio de Hacienda de Costa Rica (v4.4) — TypeScript/Node",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@peculiar/webcrypto": "^1.7.1",
    "@prisma/client": "^6.2.1",
    "@xmldom/xmldom": "^0.8.13",
    "fastify": "^5.2.0",
    "node-forge": "^1.4.0",
    "undici": "^7.2.0",
    "xadesjs": "^2.6.7",
    "xmlbuilder2": "^3.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/node-forge": "^1.3.14",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
