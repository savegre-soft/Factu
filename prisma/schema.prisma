// Esquema de persistencia. Alineado con las interfaces de src/infra/repos/types.ts.
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Emisor de comprobantes electrónicos (la empresa que factura).
model Emisor {
  cedula    String   @id
  nombre    String
  /// Certificado .p12 cifrado (JSON de SecretoSellado). NUNCA en texto plano.
  certP12       String?
  /// Clave del .p12, cifrada (JSON de SecretoSellado).
  certPassword  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comprobantes Comprobante[]
}

/// Un comprobante electrónico emitido (factura, tiquete, nota, etc.).
model Comprobante {
  /// Clave numérica de 50 dígitos.
  clave        String   @id
  cedulaEmisor String
  emisor       Emisor   @relation(fields: [cedulaEmisor], references: [cedula])
  /// Tipo de documento: FE, TE, NC, ND.
  tipo         String
  consecutivo  String
  /// Estado devuelto por Hacienda: aceptado, rechazado, procesando, etc.
  estado       String
  /// XML firmado enviado a Hacienda.
  xmlFirmado   String?
  /// XML de respuesta de Hacienda.
  respuestaXml String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cedulaEmisor])
}
