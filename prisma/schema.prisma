// Esquema de persistencia. Alineado con las interfaces de src/infra/repos/types.ts.
// Docs: https://www.prisma.io/docs

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; "debian-openssl-3.0.x" para la imagen Docker.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Organización (cliente de la API). Agrupa usuarios y emisores.
model Tenant {
  id        String   @id
  nombre    String
  createdAt DateTime @default(now())

  usuarios  Usuario[]
  emisores  Emisor[]
  apiKeys   ApiKey[]
  recibidos DocumentoRecibido[]
  buzon     Buzon?
  borradores Borrador[]
  smtp      SmtpSaliente?
  suscripcion Suscripcion?
}

/// Configuración de correo SALIENTE (SMTP) de una organización, para entregar los
/// comprobantes al cliente. La contraseña se guarda CIFRADA (JSON de SecretoSellado).
model SmtpSaliente {
  tenantId        String   @id
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  host            String
  port            Int      @default(587)
  /// TLS directo (true, puerto 465) o STARTTLS (false, puerto 587).
  secure          Boolean  @default(false)
  usuario         String?
  /// Contraseña cifrada (JSON de SecretoSellado). Opcional (SMTP sin auth).
  passwordSellado String?
  /// Remitente visible, ej. "Mi Empresa <facturas@empresa.cr>".
  remitente       String
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Una factura guardada en borrador (aún no emitida). Guarda el estado del
/// formulario de emisión (JSON) para retomarla luego.
model Borrador {
  id             String   @id
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  /// factura | tiquete | nota-credito | nota-debito
  tipo           String
  cedulaEmisor   String?
  receptorNombre String?
  total          Float    @default(0)
  /// Estado del formulario de emisión, serializado a JSON.
  datos          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

/// Buzón de correo (IMAP) de una organización, del que se leen los XML que le
/// emiten. La contraseña se guarda CIFRADA (JSON de SecretoSellado).
model Buzon {
  tenantId       String    @id
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  host           String
  port           Int
  /// TLS directo (true, típico puerto 993) o STARTTLS/none.
  secure         Boolean   @default(true)
  usuario        String
  /// Contraseña cifrada (JSON de SecretoSellado). NUNCA en texto plano.
  passwordSellado String
  /// Carpeta a revisar (por defecto INBOX).
  carpeta        String    @default("INBOX")
  activo         Boolean   @default(true)
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Usuario que accede a la API, dentro de un tenant y con un rol.
model Usuario {
  id           String   @id
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  nombre       String
  passwordHash String
  /// admin | facturador | lector
  rol          String
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

/// Credencial de una aplicación externa (cuenta de servicio) para emitir vía API.
/// Se guarda solo el hash del secreto; el `keyId` (público) permite el lookup.
model ApiKey {
  id                 String    @id
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  /// Nombre legible de la integración (ej. "ERP de ventas").
  label              String
  /// Prefijo público e indexado de la key (para lookup O(1)).
  keyId              String    @unique
  /// Hash scrypt del secreto (nunca el secreto en claro).
  secretHash         String
  /// Rol efectivo de la credencial: facturador | lector.
  rol                String
  /// Cédulas de emisor a las que se limita (vacío = todos los del tenant).
  emisoresPermitidos String[]
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  @@index([tenantId])
}

/// Emisor de comprobantes electrónicos (la empresa que factura).
model Emisor {
  cedula    String   @id
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  nombre    String
  /// Datos fiscales del emisor (JSON): tipo id, actividad, nombre comercial,
  /// correo, teléfono y ubicación. Se usan al emitir sin reingresarlos.
  datosFiscales String?
  /// Certificado .p12 cifrado (JSON de SecretoSellado). NUNCA en texto plano.
  certP12       String?
  /// Clave del .p12, cifrada (JSON de SecretoSellado).
  certPassword  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comprobantes Comprobante[]

  @@index([tenantId])
}

/// Identidad OAuth vinculada a un usuario (Google / Microsoft). Un usuario puede
/// tener varias (una por proveedor). Permite iniciar sesión con ese proveedor.
model OAuthIdentity {
  id          String   @id
  userId      String
  /// google | microsoft
  provider    String
  /// Identificador estable del usuario en el proveedor (claim "sub").
  providerSub String
  email       String
  createdAt   DateTime @default(now())

  @@unique([provider, providerSub])
  @@index([userId])
}

/// Código de un solo uso para restablecer la contraseña. Se envía por el SMTP de
/// la plataforma y vence pronto.
model PasswordReset {
  id         String   @id
  userId     String
  /// Hash del código (nunca en claro).
  codigoHash String
  expiresAt  DateTime
  usado      Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Un cliente (receptor) usado en facturas pasadas. Permite autocompletar el
/// receptor por su número de identificación al emitir. Uno por tenant + número.
model Cliente {
  id             String   @id
  tenantId       String
  /// Número de identificación (cédula) del receptor.
  numero         String
  /// Tipo de identificación (01 física, 02 jurídica, …).
  tipo           String
  nombre         String
  correo         String?
  /// Payload completo del receptor (JSON de DatosReceptor) para autocompletar.
  datos          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId])
}

/// Endpoint de webhook saliente de una organización: recibe por HTTP los eventos
/// a los que está suscrito. El secreto (para firmar HMAC) se guarda cifrado.
model Webhook {
  id           String   @id
  tenantId     String
  url          String
  /// Secreto para firmar (JSON de SecretoSellado). Opcional.
  secretSellado String?
  /// Eventos suscritos, ej. ["comprobante.aceptado","documento.recibido"].
  eventos      String[]
  activo       Boolean  @default(true)
  lastStatus   Int?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
}

/// Auditoría de cada intento de entrega de un webhook (historial + reintentos).
model WebhookEntrega {
  id         String   @id
  tenantId   String
  webhookId  String
  evento     String
  /// Cuerpo JSON enviado.
  payload    String
  /// pendiente | enviado | fallido
  estado     String
  statusCode Int?
  error      String?
  intentos   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, webhookId])
  @@index([estado])
}

/// Mensaje de chat entre dos usuarios de una misma organización (tenant).
model Mensaje {
  id        String   @id
  tenantId  String
  /// Usuario que envía.
  deId      String
  /// Usuario que recibe.
  paraId    String
  texto     String
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, deId, paraId])
  @@index([tenantId, paraId, leido])
}

/// Registro de auditoría de cada envío del comprobante al cliente por correo.
/// Hay una fila por intento/destinatario (historial y reintentos).
model EnvioComprobante {
  id           String   @id
  tenantId     String
  /// Clave del comprobante emitido que se entrega.
  clave        String
  cedulaEmisor String
  destinatario String
  asunto       String
  /// pendiente | enviado | fallido
  estado       String
  error        String?
  intentos     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId])
  @@index([clave])
}

/// Un comprobante que NOS emitieron (factura recibida), para responder con el
/// mensaje receptor. Se ingresa por carga manual, routing interno o correo.
model DocumentoRecibido {
  id                 String   @id
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  /// Clave de 50 dígitos del comprobante recibido.
  clave              String
  /// Tipo: FE, TE, NC, ND.
  tipo               String
  numeroConsecutivo  String
  fechaEmision       DateTime
  emisorNombre       String
  emisorCedula       String
  /// Cédula del receptor (uno de nuestros emisores).
  receptorCedula     String
  receptorNombre     String?
  moneda             String
  totalComprobante   Float
  totalImpuesto      Float
  /// XML original del comprobante recibido.
  xml                String
  /// Origen del documento: manual | interno | correo.
  origen             String
  /// Mensaje receptor generado (si ya se respondió).
  mrRespuesta        String?
  mrConsecutivo      String?
  mrXml              String?
  mrGeneradoAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, clave])
  @@index([tenantId])
  @@index([receptorCedula])
}

/// Un comprobante electrónico emitido (factura, tiquete, nota, etc.).
model Comprobante {
  /// Clave numérica de 50 dígitos.
  clave        String   @id
  cedulaEmisor String
  emisor       Emisor   @relation(fields: [cedulaEmisor], references: [cedula])
  /// Tipo de documento: FE, TE, NC, ND.
  tipo         String
  consecutivo  String
  /// Estado devuelto por Hacienda: aceptado, rechazado, procesando, etc.
  estado       String
  /// XML firmado enviado a Hacienda.
  xmlFirmado   String?
  /// XML de respuesta de Hacienda.
  respuestaXml String?
  /// Idempotencia: id opaco del sistema externo que pidió la emisión (ej. el
  /// id de la factura en RestauCloud). Si `/comprobante/:tipo/enviar` recibe
  /// el mismo par (cedulaEmisor, referenciaExterna) dos veces, la segunda
  /// llamada devuelve este mismo comprobante en vez de crear uno nuevo — sin
  /// esto, un reintento tras un fallo de red podría duplicar un documento
  /// fiscal real ya aceptado por Hacienda.
  referenciaExterna String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cedulaEmisor])
  @@unique([cedulaEmisor, referenciaExterna], name: "uniq_comprobante_referencia")
}

/// Contador atómico de consecutivo por emisor+sucursal+terminal+tipo (D9).
/// Cuando el cliente no manda `consecutivo`, Factu asigna el siguiente valor
/// aquí de forma atómica (evita colisiones con múltiples cajeros/sucursales
/// emitiendo en paralelo bajo el mismo emisor).
model ConsecutivoContador {
  cedulaEmisor String
  sucursal     Int
  terminal     Int
  /// Tipo de comprobante ("01".."05", ver TipoComprobante).
  tipo         String
  valor        Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([cedulaEmisor, sucursal, terminal, tipo])
}

/// Auditoría: acciones de negocio atribuibles a un usuario o integración.
model RegistroAuditoria {
  id          String   @id
  tenantId    String
  /// Id del usuario o API key que ejecutó la acción (null = sistema).
  actorId     String?
  /// Nombre legible del actor al momento de la acción.
  actorNombre String
  /// Tipo de actor: usuario | apikey | sistema.
  actorTipo   String
  /// Acción, ej. "comprobante.emitir", "webhook.crear", "auth.login".
  accion      String
  /// Recurso afectado, ej. "comprobante", "webhook".
  recurso     String
  /// Id/clave del recurso afectado, si aplica.
  recursoId   String?
  /// Detalle legible de la acción.
  detalle     String?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, accion])
}

/// Registro del sistema (logs técnicos): pollers, entregas, errores.
model RegistroLog {
  id        String   @id
  /// Tenant asociado (null = evento global de la plataforma).
  tenantId  String?
  /// Nivel: info | warn | error.
  nivel     String
  /// Origen, ej. "webhooks", "entrega", "correo", "api", "auth".
  origen    String
  mensaje   String
  /// Detalle adicional (mensaje de error, JSON, etc.).
  detalle   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([nivel])
}

/// Canal de comunicación configurado por una organización (Notificaciones).
/// Un canal = un proveedor concreto (Twilio, WhatsApp Cloud, Slack, Teams) con
/// su configuración cifrada, suscrito a uno o varios eventos.
model NotificationChannel {
  id            String   @id
  tenantId      String
  /// Tipo de canal: sms | whatsapp | slack | teams.
  tipo          String
  /// Proveedor concreto: twilio | whatsapp_cloud | slack | teams.
  proveedor     String
  nombre        String
  /// Configuración cifrada (JSON de SecretoSellado): credenciales + destino.
  configSellado String
  /// Eventos suscritos, ej. ["comprobante.aceptado","entrega.cliente"].
  eventos       String[]
  activo        Boolean  @default(true)
  /// Resultado del último envío por este canal: enviado | fallido.
  lastStatus    String?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
}

/// Suscripción de Savegre a un tenant (cobro por usar Factu). RF panel interno
/// de plataforma (Savegre Center) — mismo espíritu que `Subscription` en
/// RestauCloud-API, pero sin motor de módulos: Factu es un producto único.
/// Un tenant sin fila aquí se trata como "activa" (no bloqueado).
model Suscripcion {
  id             String    @id
  tenantId       String    @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  plan           String
  /// activa | suspendida | cancelada
  estado         String
  /// Ej. "CRC", "USD".
  moneda         String
  /// mensual | anual
  ciclo          String
  /// porcentaje | monto | null (sin descuento)
  descuentoTipo  String?
  descuentoValor Float?
  descuentoRazon String?
  iniciaEn       DateTime
  renuevaEn      DateTime?
  notas          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  pagos PagoSuscripcion[]
}

/// Historial de cobros de Savegre a un tenant por su suscripción a Factu.
model PagoSuscripcion {
  id            String      @id
  suscripcionId String
  suscripcion   Suscripcion @relation(fields: [suscripcionId], references: [id], onDelete: Cascade)
  monto         Float
  moneda        String
  /// Texto libre, ej. "transferencia", "tarjeta".
  metodo        String
  referencia    String?
  notas         String?
  pagadoEn      DateTime    @default(now())
  /// Quién lo registró (texto libre: staff de Savegre vía Center, no un Usuario de Factu).
  registradoPor String?

  @@index([suscripcionId, pagadoEn])
}

/// Credencial de servicio GLOBAL (sin tenant) para que Savegre Center consuma
/// las rutas `/plataforma/*`. Deliberadamente separada de `ApiKey` (que está
/// scoped a un tenant, para integraciones que emiten facturas).
model CredencialPlataforma {
  id         String    @id
  label      String
  /// Prefijo público e indexado de la credencial (para lookup O(1)).
  keyId      String    @unique
  /// Hash scrypt del secreto (nunca el secreto en claro).
  secretHash String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

/// Una notificación encolada/enviada por un canal (historial + reintentos).
model NotificationMessage {
  id                 String    @id
  tenantId           String
  canalId            String
  proveedor          String
  evento             String
  /// Destino visible (teléfono, "Slack", "Teams").
  destino            String?
  /// Texto renderizado que se envió.
  contenido          String
  /// pendiente | enviado | fallido | reintentando
  estado             String
  intentos           Int       @default(0)
  maxIntentos        Int
  /// Momento del próximo reintento (backoff). Null si no aplica.
  proximoIntentoAt   DateTime?
  /// Id del mensaje en el proveedor (ej. Twilio SID, WhatsApp message id).
  proveedorMensajeId String?
  /// Respuesta cruda del proveedor (JSON serializado).
  respuesta          String?
  error              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, canalId])
  @@index([estado, proximoIntentoAt])
}
