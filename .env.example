# Copia este archivo a .env y completa los valores.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/factu?schema=public"

# Ambiente de Hacienda: "stag" (pruebas) o "prod" (producción)
HACIENDA_ENV=stag

# Endpoints de Hacienda (ambiente de PRUEBAS / staging)
# IDP (autenticación OAuth - Keycloak)
HACIENDA_IDP_URL="https://idp.comprobanteselectronicos.go.cr/auth/realms/rut-stag/protocol/openid-connect/token"
# API de recepción de comprobantes
HACIENDA_API_URL="https://api-sandbox.comprobanteselectronicos.go.cr/recepcion/v1"
# Client ID del ambiente de pruebas
HACIENDA_CLIENT_ID="api-stag"
