# Copia este archivo a .env y completa los valores.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/factu?schema=public"

# Ambiente de Hacienda: "stag" (pruebas) o "prod" (producción).
# Con solo esta variable se eligen los endpoints y el client_id oficiales del
# ambiente. Para pasar a producción basta con HACIENDA_ENV=prod (+ certificado
# real, credenciales de prod y la política de firma EPES de más abajo).
HACIENDA_ENV=stag

# (Opcional) Sobrescribe los endpoints por defecto solo si Hacienda publica otros.
# Déjalos vacíos para usar los del ambiente seleccionado por HACIENDA_ENV.
#   stag: realm rut-stag + api-sandbox   ·   prod: realm rut + api
# HACIENDA_IDP_URL=""
# HACIENDA_API_URL=""
# HACIENDA_CLIENT_ID=""

# Backend de persistencia: "memoria" (por defecto) o "prisma"
PERSISTENCIA=memoria

# Revisión automática de los buzones de correo (XML entrantes).
CORREO_POLL_ENABLED=true
CORREO_POLL_MINUTOS=5

# Llave maestra para cifrar los certificados .p12 en reposo (AES-256-GCM).
# OBLIGATORIA en producción. Genera una aleatoria y guárdala de forma segura.
FACTU_MASTER_KEY=""

# Secreto para firmar los JWT de sesión de usuario. OBLIGATORIO en producción.
JWT_SECRET=""
# Vigencia del token de usuario (ej. "8h", "7d")
JWT_EXPIRES_IN="8h"

# Política de firma XAdES-EPES (obligatoria para producción). Sin estos valores
# la firma se genera como XAdES-BES. Usa la URL del documento de la resolución
# vigente (v4.4) y su digest SHA-256 en base64.
HACIENDA_POLICY_URL=""
HACIENDA_POLICY_HASH=""
