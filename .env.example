# Copia este archivo a .env y completa los valores.

# Servidor
PORT=3000
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/factu?schema=public"

# Ambiente de Hacienda: "stag" (pruebas) o "prod" (producción).
# Con solo esta variable se eligen los endpoints y el client_id oficiales del
# ambiente. Para pasar a producción basta con HACIENDA_ENV=prod (+ certificado
# real, credenciales de prod y la política de firma EPES de más abajo).
HACIENDA_ENV=stag

# (Opcional) Sobrescribe los endpoints por defecto solo si Hacienda publica otros.
# Déjalos vacíos para usar los del ambiente seleccionado por HACIENDA_ENV.
#   stag: realm rut-stag + api-sandbox   ·   prod: realm rut + api
# HACIENDA_IDP_URL=""
# HACIENDA_API_URL=""
# HACIENDA_CLIENT_ID=""

# Backend de persistencia: "memoria" (por defecto) o "prisma"
PERSISTENCIA=memoria

# Revisión automática de los buzones de correo (XML entrantes).
CORREO_POLL_ENABLED=true
CORREO_POLL_MINUTOS=5

# --- Entrega del comprobante al cliente por correo (SMTP saliente) ---
# Tras la ACEPTACIÓN de Hacienda, se envía al correo del receptor un correo con
# el PDF y el XML firmado. Requiere SMTP configurado.
ENTREGA_ENABLED=true
ENTREGA_MAX_INTENTOS=3
ENTREGA_POLL_MINUTOS=5
# SMTP (compatible con SendGrid, Amazon SES, Mailgun, etc. vía SMTP):
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# Remitente visible, ej. "Mi Empresa <facturas@empresa.cr>"
SMTP_FROM=""

# Llave maestra para cifrar los certificados .p12 en reposo (AES-256-GCM).
# OBLIGATORIA en producción. Genera una aleatoria y guárdala de forma segura.
FACTU_MASTER_KEY=""

# Secreto para firmar los JWT de sesión de usuario. OBLIGATORIO en producción.
JWT_SECRET=""
# Vigencia del token de usuario (ej. "8h", "7d")
JWT_EXPIRES_IN="8h"

# Política de firma XAdES-EPES (obligatoria para producción). Sin estos valores
# la firma se genera como XAdES-BES. Usa la URL del documento de la resolución
# vigente (v4.4) y su digest SHA-256 en base64.
HACIENDA_POLICY_URL=""
HACIENDA_POLICY_HASH=""

# --- URLs públicas (OAuth y enlaces por correo) ---
# APP_URL: base del frontend (a donde vuelve el OAuth y apuntan los enlaces).
# API_PUBLIC_URL: base pública de esta API (redirect_uri registrado en Google/MS).
APP_URL="http://localhost:5173"
API_PUBLIC_URL="http://localhost:3000"

# --- OAuth: iniciar sesión / registrarse con Google y Microsoft ---
# Google: crea credenciales OAuth en https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {API_PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Microsoft: registra una app en Azure Portal → App registrations
#   Redirect URI (Web): {API_PUBLIC_URL}/auth/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=""
MICROSOFT_OAUTH_CLIENT_SECRET=""
# Tenant de Azure AD: "common" (personales + trabajo), "organizations" o un GUID.
MICROSOFT_OAUTH_TENANT="common"

# --- SMTP PROPIO DE LA PLATAFORMA (correos de la cuenta) ---
# Se usa SOLO para correos de la plataforma a sus usuarios (código para resetear
# la contraseña). NO es el SMTP_* de arriba, que la API usa para enviar los
# comprobantes a los CLIENTES de cada organización.
PLATAFORMA_SMTP_HOST=""
PLATAFORMA_SMTP_PORT=587
PLATAFORMA_SMTP_SECURE=false
PLATAFORMA_SMTP_USER=""
PLATAFORMA_SMTP_PASS=""
# Remitente visible, ej. "Factu <no-reply@miplataforma.cr>"
PLATAFORMA_SMTP_FROM=""
# Minutos de vigencia del código de reseteo de contraseña.
PASSWORD_RESET_TTL_MINUTOS=15
